gzip on;
gzip_types application/json text/plain application/javascript text/css;
gzip_min_length 1024;
gzip_comp_level 6;
gzip_vary on;

limit_req_zone $binary_remote_addr zone=api:10m rate=5r/s;

server {
    listen 80;

    server_tokens off;

    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;

    location = /wp-login.php { return 444; }
    location = /xmlrpc.php { return 444; }

    if ($request_method !~ ^(GET|HEAD|POST|OPTIONS)$) {
        return 444;
    }

    location ^~ /vendor/ { return 403; }
    location ^~ /cgi-bin/ { return 403; }
    location ^~ /tests/ { return 403; }
    location ~* /(phpunit|\.env|\.git|composer\.(json|lock)) { return 403; }
    
    location ~* \.(php|asp|aspx|jsp|cgi|pl|env)$ {
        return 444;
    }

    location ~* /(wp-admin|wp-content|wordpress|boaform|setup\.cgi) {
        return 444;
    }

    location ~ /\. { return 403; }

    location / {
        limit_req_zone $binary_remote_addr zone=api:10m rate=3r/s;
        
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri /index.html;
    }

    location /api/ {
        limit_req_zone $binary_remote_addr zone=api:10m rate=3r/s;

        proxy_connect_timeout 5s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        
        if ($http_user_agent = "") {
           return 444;
        }

        proxy_pass http://redis-server:3030/;
        proxy_http_version 1.1;

        proxy_set_header Accept-Encoding "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}


    
